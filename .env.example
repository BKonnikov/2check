# Environment / Среда: development | test | staging | production
NODE_ENV=development

# Internal web API / Внутренний веб-API
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Where the web interface reaches the internal web API / Адрес внутреннего веб-API
API_ORIGIN=http://127.0.0.1:3001

# Reusable result cache / Кэш повторно используемых результатов
REDIS_URL=redis://127.0.0.1:6379

# Registry provider endpoints / Адреса провайдера регистрации (PRD 9.1)
REGISTRY_RDAP_BASE=https://rdap.cctld.uz
REGISTRY_WHOIS_HOST=whois.cctld.uz

# Scan store / Хранилище сканирований
DATABASE_URL=postgres://twocheck:twocheck@127.0.0.1:5432/twocheck

# Release identifier / Идентификатор выпуска
APPLICATION_RELEASE_VERSION=0.0.0-dev

# PRD 22.2 — the limits that keep one server from being exhausted by its own traffic.
# The budget for a whole scan, not for one provider call.
SCAN_DEADLINE_MS=30000
# How many scans may execute at once before the service answers 503.
SCAN_MAX_CONCURRENT=4
# How many scans one caller may start per minute before the service answers 429.
SCAN_RATE_LIMIT_PER_MINUTE=12

# PRD 15.10 — адреса, которые этот экземпляр не должен опрашивать, через запятую.
# Смысл — собственное сетевое окружение сканера: адреса, до которых путь отсюда не тот, каким
# идёт посетитель, поэтому наблюдение о них недостоверно. Названные здесь дают честное
# «не удалось проверить» вместо уверенного вердикта. Пусто по умолчанию; некорректная запись
# не даёт сервису запуститься.
# SECURITY_INTERNAL_DENYLIST=91.216.37.0/24
SECURITY_INTERNAL_DENYLIST=
